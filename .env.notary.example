# Copy this file to .env.notary, keep it chmod 600, and fill in the password.
LIGHTVIEW_NOTARY_PROFILE=LightView-Notary
LIGHTVIEW_APPLE_ID=your-apple-id@example.com
LIGHTVIEW_TEAM_ID=YOURTEAMID
LIGHTVIEW_APP_SPECIFIC_PASSWORD=
# Optional when the default data-protection keychain is unavailable:
# LIGHTVIEW_NOTARY_KEYCHAIN=/Users/your-name/Library/Keychains/login.keychain-db
