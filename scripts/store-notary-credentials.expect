#!/usr/bin/expect -f

if {$argc != 3} {
    puts stderr "Usage: store-notary-credentials.expect PROFILE APPLE_ID TEAM_ID"
    exit 64
}

set timeout -1
set profile [lindex $argv 0]
set apple_id [lindex $argv 1]
set team_id [lindex $argv 2]
set password [gets stdin]

if {$password eq ""} {
    puts stderr "The App-specific password is empty."
    exit 65
}

spawn xcrun notarytool store-credentials $profile --apple-id $apple_id --team-id $team_id
expect {
    -re {App-specific password.*: $} {
        send -- "$password\r"
        set password ""
        exp_continue
    }
    eof
}

set wait_result [wait]
exit [lindex $wait_result 3]
